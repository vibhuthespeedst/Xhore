{
  "name": "xhore",
  "version": "0.0.0",
  "private": true,
  "description": "Workout avatar app: real gym sets grow a 3D avatar's muscles.",
  "workspaces": [
    "engine",
    "shared/*",
    "prototype"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @xhore/prototype",
    "build": "npm run build --workspace @xhore/prototype",
    "build:body": "node tools/avatar-pipeline/run.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace @xhore/engine",
    "curve": "npm run curve --workspace @xhore/engine",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
